module(
    name = "basic",
    version = "0.1.0",
)

bazel_dep(
    name = "rules_erlang",
    version = "3.21.0",
)
bazel_dep(
    name = "rules_elixir",
    version = "1.2.0",
)
local_path_override(
    module_name = "rules_elixir",
    path = "../..",
)

# See the note in the root MODULE.bazel. This example is its own module, so it
# needs its own override; the one in the ruleset it depends on does not carry
# over.
git_override(
    module_name = "rules_erlang",
    commit = "13977b3309fd0b0d6795f322cffd86a8c161be64",  # 3.21.0
    remote = "https://github.com/bazelverse/rules_erlang.git",
)

# The platforms below inherit from the host platform. That used to be
# @local_config_platform//:host, an autoconfigured repository Bazel 8 removed;
# the replacement is @platforms//host:host, which comes from this module.
bazel_dep(
    name = "platforms",
    version = "1.1.0",
)

erlang_config = use_extension(
    "@rules_erlang//bzlmod:extensions.bzl",
    "erlang_config",
)
erlang_config.internal_erlang_from_github_release(
    name = "29",
    extra_make_opts = ["-j 4"],
    sha256 = "86f6f40d4638852b0383235b02a70d8450184e441e83a06a108bf8e5bf1b2e04",
    version = "29.0.5",
)
use_repo(
    erlang_config,
    "erlang_config",
)

elixir_config = use_extension(
    "@rules_elixir//bzlmod:extensions.bzl",
    "elixir_config",
)
elixir_config.internal_elixir_from_github_release(
    name = "1_20",
    sha256 = "ff22a894b130631443db1a193b4e8cb4762f697128566e43da848fd16c3777bd",
    version = "1.20.3",
)
use_repo(
    elixir_config,
    "elixir_config",
)

register_toolchains(
    "@erlang_config//29:toolchain_major",
    "@erlang_config//29:toolchain_major_minor",
    "@elixir_config//1_20:toolchain",
)
