load("@rules_elixir//:elixir_release.bzl", "elixir_release")
load("@rules_elixir//:elixir_test.bzl", "elixir_test")
load("@rules_elixir//:ex_unit_test.bzl", "ex_unit_test")
load("@rules_elixir//:mix_app.bzl", "mix_app")
load("@rules_elixir//:mix_config.bzl", "mix_config")
load("@rules_elixir//:mix_lock_test.bzl", "mix_lock_test")
load("@rules_elixir//:mix_payloads.bzl", "mix_payloads")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@sample_deps//:defs.bzl", "mix_dependencies")
load("@sample_deps//:sources.bzl", "mix_dependency_sources")
load(":generated.bzl", "generated_sources")

mix_config(
    name = "compile_config",
    srcs = glob(["config/**"]),
    config = "config/config.exs",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    srcs = [
        "mix.exs",
        "mix.lock",
    ] + glob(["config/**"]),
)

mix_lock_test(
    name = "lock_test",
    manifest = "rules_elixir.lock.json",
    sources = mix_dependency_sources() | {
        ":sources": "",
        "//dep:sources": "dep",
        "//native:sources": "native",
    },
)

mix_app(
    name = "app",
    srcs = ["mix.lock"] + glob([
        "config/**",
        "lib/**",
        "priv/**",
    ]) + select({
        "@rules_elixir//:mix_test": glob(["support/**"]),
        "//conditions:default": [],
    }),
    app_name = "sample",
    generated_srcs = {":generated": "generated"},
    mix_exs = "mix.exs",
    deps = mix_dependencies(),
)

elixir_test(
    name = "test",
    srcs = glob(["test/**"]),
    app = ":app",
    shard_count = 2,
)

elixir_release(
    name = "release",
    app = ":app",
    release = "sample",
)

elixir_release(
    name = "load_only",
    app = ":app",
    release = "load_only",
)

sh_test(
    name = "release_contract_test",
    srcs = ["release_contract_test.sh"],
    data = [
        ":load_only",
        ":release",
    ],
)

generated_sources(name = "generated")

ex_unit_test(
    name = "legacy_interop_test",
    srcs = ["legacy_interop_test.exs"],
    deps = [
        "//dep:app",
        "//rebar:app",
    ],
)

mix_payloads(
    name = "native_tools",
    tools = {"//native:fixture_codegen": "fixture-codegen"},
)

toolchain(
    name = "native_toolchain",
    toolchain = ":native_tools",
    toolchain_type = "@rules_elixir//:mix_payloads_toolchain_type",
)

# An external CI matrix can select a Mix partition without Bazel sharding.
elixir_test(
    name = "external_partition_test",
    srcs = glob(["test/**"]),
    app = ":app",
    env = {
        "EXPECTED_MIX_TEST_PARTITION": "2",
        "MIX_TEST_PARTITION": "2",
    },
    mix_args = [
        "--partitions",
        "2",
    ],
)
