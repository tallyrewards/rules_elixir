load("@rules_elixir//:ex_unit_test.bzl", "ex_unit_test")
load("@rules_elixir//:mix_app.bzl", "mix_app")
load("@rules_elixir//:mix_config.bzl", "mix_config")
load("@rules_elixir//:mix_lock_test.bzl", "mix_lock_test")
load("@sample_deps//:defs.bzl", "mix_dependencies")
load("@sample_deps//:sources.bzl", "mix_dependency_sources")
load(":generated.bzl", "generated_sources")

mix_config(
    name = "compile_config",
    srcs = glob(["config/**"]),
    config = "config/config.exs",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    srcs = [
        "mix.exs",
        "mix.lock",
    ] + glob(["config/**"]),
)

mix_lock_test(
    name = "lock_test",
    manifest = "rules_elixir.lock.json",
    sources = mix_dependency_sources() | {
        ":sources": "",
        "//dep:sources": "dep",
    },
)

mix_app(
    name = "app",
    srcs = ["mix.lock"] + glob([
        "config/**",
        "lib/**",
        "priv/**",
    ]),
    app_name = "sample",
    generated_srcs = {":generated": "generated"},
    mix_exs = "mix.exs",
    deps = mix_dependencies(),
)

generated_sources(name = "generated")

ex_unit_test(
    name = "legacy_interop_test",
    srcs = ["legacy_interop_test.exs"],
    deps = [
        "//dep:app",
        "//rebar:app",
    ],
)
