module(
    name = "mix_example",
    version = "0.1.0",
)

bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(
    name = "rules_erlang",
    version = "3.21.0",
)
bazel_dep(
    name = "rules_elixir",
    version = "1.2.0",
)
local_path_override(
    module_name = "rules_elixir",
    path = "../..",
)

# See the note in the root MODULE.bazel. This example is its own module, so it
# needs its own override; the one in the ruleset it depends on does not carry
# over.
git_override(
    module_name = "rules_erlang",
    commit = "13977b3309fd0b0d6795f322cffd86a8c161be64",  # 3.21.0
    remote = "https://github.com/bazelverse/rules_erlang.git",
)

packages = use_extension("@rules_elixir//bzlmod:mix_deps.bzl", "mix_deps")
packages.from_file(
    name = "sample_deps",
    compile_config = "//:compile_config",
    manifest = "//:rules_elixir.lock.json",
)
packages.override(
    app = "sample_dep",
    graph = "sample_deps",
    target = "//dep:app",
)
use_repo(packages, "sample_deps")
