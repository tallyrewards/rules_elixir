module(
    name = "basic",
    version = "0.1.0",
)

bazel_dep(
    name = "rules_erlang",
    version = "3.21.0",
)
bazel_dep(
    name = "rules_elixir",
    version = "1.2.0",
)
local_path_override(
    module_name = "rules_elixir",
    path = "..",
)

# sh_test stopped being a native rule in Bazel 8, so BUILD.bazel loads it from
# @rules_shell and this module has to depend on it directly.
bazel_dep(
    name = "rules_shell",
    version = "0.8.0",
)

# See the note in the root MODULE.bazel. This is a separate module, so it needs
# its own override; the one in the ruleset it depends on does not carry over.
git_override(
    module_name = "rules_erlang",
    commit = "13977b3309fd0b0d6795f322cffd86a8c161be64",  # 3.21.0
    remote = "https://github.com/bazelverse/rules_erlang.git",
)

erlang_config = use_extension(
    "@rules_erlang//bzlmod:extensions.bzl",
    "erlang_config",
)
use_repo(
    erlang_config,
    "erlang_config",
)
